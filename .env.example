# Anthropic API キー（必須）
ANTHROPIC_API_KEY=your_api_key_here

# Google スプレッドシートのID（URLの /d/ と /edit の間の文字列）
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Google サービスアカウントのJSONファイルパス
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── Outlook自動取込（バッチ処理用）────────────────────────────────
# Azure AD アプリ登録情報（ポータル: portal.azure.com）
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# 取得対象のメールボックスアドレス（会社の案件受信用アドレス）
OUTLOOK_TARGET_EMAIL=jobs@yourcompany.com

# バッチ取得する時間範囲（時間単位、デフォルト25時間）
FETCH_HOURS=25

# 処理済みメールを移動するOutlookフォルダ名
PROCESSED_FOLDER=案件処理済み
