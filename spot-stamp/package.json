{
  "name": "spot-stamp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "お気に入りスポットを地図で共有してスタンプラリーで集めるWebアプリ",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
